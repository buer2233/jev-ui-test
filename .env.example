# TYPESAFE官方的jev
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# ===== 决策模型（Jev）——推荐经 OpenRouter 调用 =====
# 推荐：填入你自己的 OpenRouter Key（大陆网络可直连，无需代理）。
# ⚠️ DECISION_BASE_URL 必须是【完整 URL（要包含 /v1/systemone）】：
#    本框架不会自动补路径；照抄 OpenRouter 文档里的 SDK base
#    （https://openrouter.ai/api）会被当成端点直接请求，结果为 404。
DECISION_BASE_URL=https://openrouter.ai/api/v1/systemone
DECISION_API_KEY=sk-or-v1-xx
DECISION_MODEL=jev-latest
# 思考模式：留空 = 服务端默认（本地 AutoThink 的默认就是 auto，会"想清楚再答"）。
# ⚠️ 部署 Instant（极速版）型号时必须留空或填 never——填 auto/always 会被 422 拒绝。
DECISION_THINK_MODE=
# 单次决策超时（秒），留空 = 25。本地模型"思考"时单步更慢，按需调大。
DECISION_TIMEOUT_S=

# ── 决策模型端点（可替换）：什么都不填 = 直连 TypeSafe 官方 Jev ──────────────
# 不配任何 DECISION_* = 沿用 TYPESAFE_API_KEY 直连
# https://api.typesafe.ai/v1/systemone，行为与改造前完全一致。
# 换端点时凭据与端点【同源】：自定义端点只认 DECISION_API_KEY（不回落到
# TypeSafe 的 key）；自托管服务器未开鉴权时留空即可。部署细节见
# docs/jev-model.md「换成别的决策模型」。
# 例：内网自托管的 StartLux-Decision：
#   DECISION_BASE_URL=http://<内网GPU主机>:8090/v1/systemone
#   DECISION_API_KEY=
#   DECISION_MODEL=startlux-decision-27b-autothink
#   DECISION_TIMEOUT_S=120         # 思考中的 AutoThink 响应可远超默认 25s
# DECISION_BASE_URL=
# DECISION_API_KEY=
# DECISION_MODEL=

# ── 决策模型的思考控制（可选；只有 StartLux 这类服务器认识它们）──
# 留空 = 不发送该字段（跟随服务器默认）。⚠️ 给 Instant 模型发 think_mode=auto 会被 422。
# DECISION_THINK_MODE=never      # auto / never / always
# DECISION_GATE=0.6              # 0–1：首遍读数低于它才思考
# DECISION_THINK_BUDGET=512      # 最长推理 token 数

# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# ── 可选：模型出口代理 ─────────────────────────────────────────────────────
# 如果你的网络直连 `api.typesafe.ai` 被拒（症状是 HTTP 451、
# 响应体 {"title":"Typesafe is not available in your region."}），
# 而本机有可用的代理，就把下面三个键一起填上。
# ⚠️ 三个必须一起填：只填代理不填 NO_PROXY，**内网 E9 环境与文本模型端点
# 会被一起带走**，表现为"浏览器连不上 E9"这种与模型无关的怪错。
# 451 是**出口路由**问题，不是服务故障——报错文案完全看不出这一点。
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=10.0.0.0/8,192.168.0.0/16,172.16.0.0/12,localhost,127.0.0.1,::1,.local
